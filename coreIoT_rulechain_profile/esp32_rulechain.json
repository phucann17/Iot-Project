      {
        "type": "org.thingsboard.rule.engine.transform.TbTransformMsgNode",
        "name": "Check RPC",
        "debugSettings": {
          "failuresEnabled": true,
          "allEnabled": false,
          "allEnabledUntil": 1764000917961
        },
        "singletonMode": false,
        "queueName": null,
        "configurationVersion": 0,
        "configuration": {
          "scriptLang": "TBEL",
          "jsScript": "return {msg: msg, metadata: metadata, msgType: msgType};",
          "tbelScript": "var led1 = \"OFF\";\r\nvar led2 = \"OFF\";\r\n// LED1 -> THEO NHIỆT ĐỘ\r\nif (msg.temperature >= 30) led1 = \"BLINK\";\r\nelse if (msg.temperature >= 20) led1 = \"ON\";\r\nelse led1 = \"OFF\";\r\n// LED2 -> THEO ĐỘ ẨM\r\nif (msg.humidity >= 40) led2 = \"BLINK\";\r\nelse if (msg.humidity >= 10) led2 = \"ON\";\r\nelse led2 = \"OFF\";\r\n// RPC MESSAGE GỬI SANG RASPBERRY PI\r\nvar newMsg = {\r\n    method: \"CONTROL\",\r\n    params: {\r\n        led1: led1,\r\n        led2: led2\r\n    }\r\n};\r\n// TARGET DEVICE\r\nvar newMetadata = {\r\n    deviceName: \"Raspi\",\r\n    deviceType: \"Raspi4\",\r\n    expirationTime: Date.now() + 4000,\r\n    oneway: false,\r\n    persistent: false\r\n};\r\n// RETURN\r\nreturn {\r\n    msg: newMsg,\r\n    metadata: newMetadata,\r\n    msgType: \"RPC_CALL_FROM_SERVER_TO_DEVICE\"\r\n};"
        },
        "additionalInfo": {
          "description": "",
          "layoutX": 1435,
          "layoutY": 408
        }
